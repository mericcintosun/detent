# Copy to .env.local. Every variable is optional: with none of them set the
# console runs on the cached register in lib/data.ts and evaluates the compiled
# policy locally, which is the whole demo. That keyless path is what the live
# URL and the recorded video run on, and the console says so on screen. Setting
# the values below swaps each half for its live counterpart; README.md has the
# table of which half is which.
#
# Every name here is read by the code. Nothing real belongs in this file: it is
# committed, and a key pasted into it ships to everyone who clones the repo.

# --- Adapter seam -----------------------------------------------------------
# fake serves the cached register from fixtures/register.seed.json and evaluates
# the compiled policy locally, which is the whole demo without a single key.
# real requires the Hedera and Privy values below: the register is read on chain
# and the policy is installed on the treasury wallet. Anything other than "real"
# is read as fake.
NEXT_PUBLIC_ADAPTER_MODE=fake

# --- Hedera / Asset Tokenization Studio -------------------------------------
# Chain id for Hedera testnet. Leave at 296 unless you move networks.
NEXT_PUBLIC_CHAIN_ID=296
# JSON-RPC relay. Hashio is free and rate limited; a Hedera portal key or a
# self-hosted relay is steadier during a demo. https://portal.hedera.com
NEXT_PUBLIC_HEDERA_RPC_URL=https://testnet.hashio.io/api
# EVM address of the ATS equity token you issued through the ATS factory.
# Get it from the deploy output or from HashScan after issuance. When this is
# empty, lib/hedera.ts serves the cached register instead of reading on chain.
NEXT_PUBLIC_ATS_TOKEN_ADDRESS=
# Sender the compliance read checks from: holds the token, has KYC, is on the control list (the issuer treasury).
NEXT_PUBLIC_ATS_CHECK_FROM_ADDRESS=
# Partition to read: empty is the ATS default 0x00..01, else a 32 byte hex value or a label such as CLASS-A.
NEXT_PUBLIC_ATS_PARTITION=
# The testnet settlement token whose balanceOf funds the coupon draw. Detent
# reads the treasury address from lib/data.ts against this contract, and the
# result is the treasury cover printed under the plan totals. Leave it empty to
# keep the cached cover figure; the register note then says which one you got.
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=
# PlanAnchor address, printed by the deploy step in contracts/README.md. Read by
# the anchoring path in lib/anchor.ts; the console works without it.
NEXT_PUBLIC_PLAN_ANCHOR_ADDRESS=
# Written automatically by the contract deploy step. lib/public-config.ts reads
# NEXT_PUBLIC_PLAN_ANCHOR_ADDRESS first and falls back to this one, so either
# name works and neither address is ever hardcoded.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# --- PlanAnchor operator, server side only ----------------------------------
# The same ECDSA private key that deployed PlanAnchor: the contract pins its
# operator to the deployer, so anchoring from the app needs that key. No
# NEXT_PUBLIC_ prefix, it must never reach a browser bundle. Leave it empty and
# the lock and send steps still work, they just report the anchor as skipped.
OPERATOR_PRIVATE_KEY=

# --- Privy server wallet, policies and key quorum ---------------------------
# App id and secret from the Privy dashboard: https://dashboard.privy.io
# (Settings, then Basics for the id, API keys for the secret.)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The treasury server wallet, created with POST /v1/wallets. Falls back to the
# placeholder id in lib/data.ts when unset.
PRIVY_TREASURY_WALLET_ID=
# EVM address of that same server wallet, from the POST /v1/wallets response or
# the dashboard. Only needed for the signature fallback, which fills the nonce
# from this address before broadcasting through Hashio.
PRIVY_TREASURY_WALLET_ADDRESS=
# Key quorum that owns the generated policy, threshold two. Create it in the
# dashboard under Key quorums and paste the id here.
PRIVY_KEY_QUORUM_ID=
# Authorization private keys (wallet-auth:... from the dashboard), comma separated, that sign wallet updates, rpc and policy deletes for owned resources. Server only, never NEXT_PUBLIC_.
PRIVY_AUTHORIZATION_KEYS=
# Optional, milliseconds: shortens how long a lock and its attached policy live (5000 up to the 900000 default), for rehearsing the expiry cleanup.
DETENT_LOCK_TTL_MS=
# auto asks Privy to broadcast and falls back to sign plus relay broadcast when
# Privy refuses eip155:296. Set to signature only if Privy refuses chain 296
# outright; rpc pins the Privy broadcast path for a rehearsal.
PRIVY_BROADCAST_MODE=auto
# Only override for a Privy staging host.
PRIVY_API_URL=https://api.privy.io

# --- Site metadata ----------------------------------------------------------
# Absolute origin of the deployed site. app/layout.tsx uses it as metadataBase so
# the OG image resolves to an absolute URL in view-source, which is what link
# previews need. Change it only if the deployment moves to another domain.
NEXT_PUBLIC_SITE_URL=https://detent-app.vercel.app
